<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net35</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>LiteLLM</RootNamespace>
    <AssemblyName>LiteLLM</AssemblyName>
	  <Version>0.0.0</Version>
    <Authors>mddanish00</Authors>
    <Copyright>Copyright (c) 2026 mddanish00</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath=""/>
  </ItemGroup>  

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' "/>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' "/>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net6.0|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net35|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net6.0|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net35|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <Reference Include="XUnity.AutoTranslator.Plugin.Core">
      <HintPath>..\libs-il2cpp\XUnity.AutoTranslator.Plugin.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="XUnity.Common">
      <HintPath>..\libs-il2cpp\XUnity.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <Reference Include="XUnity.AutoTranslator.Plugin.Core">
      <HintPath>..\libs\XUnity.AutoTranslator.Plugin.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="XUnity.Common">
      <HintPath>..\libs\XUnity.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
		<PackageReference Include="YamlDotNet" Version="5.0.0" />
	</ItemGroup>

</Project>
